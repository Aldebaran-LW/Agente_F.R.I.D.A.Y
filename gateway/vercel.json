{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "env": {
    "HF_FRIDAY_PROD_URL": "https://aldebaran-lw-friday-prod.hf.space"
  },
  "rewrites": [
    {
      "source": "/office",
      "destination": "/office/index.html"
    },
    {
      "source": "/forge",
      "destination": "/forge/index.html"
    },
    {
      "source": "/friday",
      "destination": "/friday/index.html"
    },
    {
      "source": "/friday/",
      "destination": "/friday/index.html"
    },
    {
      "source": "/jarvis",
      "destination": "/api/jarvis"
    },
    {
      "source": "/openclaw/:path*",
      "destination": "/api/openclaw-router?route=:path*"
    },
    {
      "source": "/api/openclaw/:path*",
      "destination": "/api/openclaw-router?route=:path*"
    }
  ]
}
