{
  "version": 2,
  "env": {
    "HF_OPENCLAW_CORE_URL": "https://aldebaran-lw-openclaw-core.hf.space",
    "HF_OPENCLAW_INNOVATION_URL": "https://aldebaran-lw-openclaw-innovation.hf.space",
    "HF_MACOFEL_SPACE_URL": "https://aldebaran-lw-macofel-agent.hf.space",
    "HF_CORPUS_DATASET": "Aldebaran-LW/openclaw-backup"
  },
  "rewrites": [
    {
      "source": "/office",
      "destination": "/office/index.html"
    },
    {
      "source": "/forge",
      "destination": "/forge/index.html"
    },
    {
      "source": "/friday",
      "destination": "/friday/index.html"
    },
    {
      "source": "/friday/",
      "destination": "/friday/index.html"
    },
    {
      "source": "/jarvis",
      "destination": "/api/jarvis"
    },
    {
      "source": "/openclaw/:path*",
      "destination": "/api/openclaw-router?route=:path*"
    },
    {
      "source": "/api/openclaw/:path*",
      "destination": "/api/openclaw-router?route=:path*"
    }
  ]
}
