{
  "_note": "Copia de referencia. Runtime na Vercel: gateway/skills/manifest.json",
  "version": "1.0.0",
  "skills": {
    "macofel-status": {
      "agent": "macofel",
      "mode": "read",
      "permissions": ["read:catalog"],
      "requiresApproval": false,
      "timeoutMs": 25000,
      "telemetry": true
    },
    "macofel-images-sync": {
      "agent": "macofel",
      "mode": "write",
      "permissions": ["write:catalog", "write:images"],
      "requiresApproval": true,
      "timeoutMs": 60000,
      "telemetry": true
    },
    "github-aldebaran": {
      "agent": "heimdall",
      "mode": "read",
      "permissions": ["read:github"],
      "requiresApproval": false,
      "timeoutMs": 20000,
      "telemetry": true
    },
    "deploy-monitor": {
      "agent": "heimdall",
      "mode": "read",
      "permissions": ["read:deploy"],
      "requiresApproval": false,
      "timeoutMs": 20000,
      "telemetry": true
    },
    "vercel-status": {
      "agent": "heimdall",
      "mode": "read",
      "permissions": ["read:deploy"],
      "requiresApproval": false,
      "timeoutMs": 25000,
      "telemetry": true
    },
    "vp-pecas-health": {
      "agent": "vp-pecas",
      "mode": "read",
      "permissions": ["read:deploy"],
      "requiresApproval": false,
      "timeoutMs": 20000,
      "telemetry": true
    }
  }
}
